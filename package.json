{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "Full-Stack URL Shortener with Base62 Encoding, Analytics Dashboard, and React Vite Frontend",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start": "npm --prefix backend start",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix backend test"
  },
  "keywords": [
    "url-shortener",
    "base62",
    "express",
    "react",
    "vite",
    "qr-code"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
